{
  "name": "railroadsim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An original railroad building and management sim",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:artifact": "npm run build && node scripts/make-artifact.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:bdd": "NODE_OPTIONS='--import tsx' cucumber-js",
    "test:wip": "NODE_OPTIONS='--import tsx' cucumber-js --profile wip",
    "test": "npm run typecheck && npm run test:unit && npm run test:bdd",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.1"
  }
}
